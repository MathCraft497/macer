package macer.lang;

public class String {
    public chars: Char[];

    public func init(cs: Char[]) {
        self.chars = cs;
    }

    // ============ 属性方法 ============

    public func length() -> Int {
        return self.chars.length;
    }

    public func isEmpty() -> Bool {
        return self.chars.length == 0;
    }

    public func at(i: Int) -> Char {
        return self.chars[i];
    }

    // ============ 方法 ============

    public func concat(other: String) -> String {
        let result: Char[] = [];
        var i: Int = 0;
        while i < self.chars.length {
            result.push(self.chars[i]);
            i = i + 1;
        }
        i = 0;
        while i < other.chars.length {
            result.push(other.chars[i]);
            i = i + 1;
        }
        return new String(result);
    }

    public func upper() -> String {
        let result: Char[] = [];
        var i: Int = 0;
        while i < self.chars.length {
            result.push(self.chars[i].toUpper());
            i = i + 1;
        }
        return new String(result);
    }

    public func lower() -> String {
        let result: Char[] = [];
        var i: Int = 0;
        while i < self.chars.length {
            result.push(self.chars[i].toLower());
            i = i + 1;
        }
        return new String(result);
    }

    public func reverse() -> String {
        let result: Char[] = [];
        var i: Int = self.chars.length - 1;
        while i >= 0 {
            result.push(self.chars[i]);
            i = i - 1;
        }
        return new String(result);
    }

    public func trim() -> String {
        var start: Int = 0;
        var end: Int = self.chars.length;
        while start < end && self.chars[start].toInt() <= 32 {
            start = start + 1;
        }
        while end > start && self.chars[end - 1].toInt() <= 32 {
            end = end - 1;
        }
        return self.slice(start, end);
    }

    public func slice(a: Int) -> String {
        return self.slice(a, self.chars.length);
    }

    public func slice(a: Int, b: Int) -> String {
        let result: Char[] = [];
        var i: Int = a;
        while i < b {
            result.push(self.chars[i]);
            i = i + 1;
        }
        return new String(result);
    }

    public func repeat(n: Int) -> String {
        let result: Char[] = [];
        var k: Int = 0;
        while k < n {
            var i: Int = 0;
            while i < self.chars.length {
                result.push(self.chars[i]);
                i = i + 1;
            }
            k = k + 1;
        }
        return new String(result);
    }

    public func find(sub: String) -> Int {
        if sub.chars.length == 0 {
            return 0;
        }
        var i: Int = 0;
        while i + sub.chars.length <= self.chars.length {
            var j: Int = 0;
            var match: Bool = true;
            while j < sub.chars.length {
                if self.chars[i + j].toInt() != sub.chars[j].toInt() {
                    match = false;
                }
                j = j + 1;
            }
            if match {
                return i;
            }
            i = i + 1;
        }
        return -1;
    }

    public func contains(sub: String) -> Bool {
        return self.find(sub) >= 0;
    }

    public func startsWith(prefix: String) -> Bool {
        if prefix.chars.length > self.chars.length {
            return false;
        }
        var i: Int = 0;
        while i < prefix.chars.length {
            if self.chars[i].toInt() != prefix.chars[i].toInt() {
                return false;
            }
            i = i + 1;
        }
        return true;
    }

    public func endsWith(suffix: String) -> Bool {
        if suffix.chars.length > self.chars.length {
            return false;
        }
        let off: Int = self.chars.length - suffix.chars.length;
        var i: Int = 0;
        while i < suffix.chars.length {
            if self.chars[off + i].toInt() != suffix.chars[i].toInt() {
                return false;
            }
            i = i + 1;
        }
        return true;
    }

    public func replace(old: String, repl: String) -> String {
        let result: Char[] = [];
        var i: Int = 0;
        while i < self.chars.length {
            if i + old.chars.length <= self.chars.length
               && self.slice(i, i + old.chars.length).find(old) == 0 {
                var j: Int = 0;
                while j < repl.chars.length {
                    result.push(repl.chars[j]);
                    j = j + 1;
                }
                i = i + old.chars.length;
            } else {
                result.push(self.chars[i]);
                i = i + 1;
            }
        }
        return new String(result);
    }

    // ============ 运算符重载 ============

    public func calc.opr+(other: String) -> String {
        return self.concat(other);
    }

    public func calc.opr==(other: String) -> Bool {
        if self.chars.length != other.chars.length {
            return false;
        }
        var i: Int = 0;
        while i < self.chars.length {
            if self.chars[i].toInt() != other.chars[i].toInt() {
                return false;
            }
            i = i + 1;
        }
        return true;
    }

    public func calc.opr!=(other: String) -> Bool {
        return !(self == other);
    }

    // ============ 索引操作：s[...] ============

    public func calc.get.opr(text: String) -> String {
        return self;
    }
}